{
  "name": "assistant-service",
  "version": "1.0.0",
  "description": "Asistente del CRM: un agente que ejecuta acciones llamando a la propia API con el token del usuario. Las lecturas salen solas; toda escritura se propone y espera confirmación humana.",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^1.19.17",
    "dotenv": "^16.4.7",
    "hono": "^4.13.7",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs"
}
